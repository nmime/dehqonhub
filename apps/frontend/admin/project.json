{
  "name": "admin-app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/admin/src",
  "projectType": "application",
  "tags": ["platform:frontend", "type:frontend-app", "scope:admin", "fsd:layer:app"],
  "// targets": "to see all targets run: nx show project admin-app --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/admin",
        "command": "NODE_ENV=test vitest run --config vitest.config.mts"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/frontend/admin"]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "VITE_E2E_COVERAGE=true VITE_API_BASE_URL_MODE=same-origin node_modules/.bin/vite build --config apps/frontend/admin/vite.config.mts && node packages/tooling/bin/repo-tooling.mjs testing frontend-browser-e2e-coverage --dist dist/apps/frontend/admin --app-name admin-app --contains \"Access denied\" --coverage-dir coverage/e2e/apps/frontend/admin && node apps/frontend/admin/scripts/assert-browser-coverage.mjs"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["@playwright/test", "vite-plugin-istanbul"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/e2e/apps/frontend/admin"]
    },
    "e2e-marketplace": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["e2e-typecheck"],
      "options": {
        "command": "VITE_API_BASE_URL_MODE=same-origin node_modules/.bin/vite build --config apps/frontend/admin/vite.config.mts && PLAYWRIGHT_HTML_OPEN=never node_modules/.bin/playwright test --config apps/frontend/admin/playwright.config.ts"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["@playwright/test"]
        }
      ],
      "outputs": ["{projectRoot}/test-results/admin-marketplace"]
    },
    "e2e-typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/admin",
        "command": "tsc --noEmit -p tsconfig.e2e.json"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["@playwright/test", "typescript"]
        }
      ]
    }
  }
}
