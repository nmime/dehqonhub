{
  "name": "@app/backend-feature-order-shared",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/feature/order/shared/lib/src",
  "projectType": "library",
  "tags": ["platform:backend", "type:feature-shared", "scope:user"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/feature/order/shared/lib",
        "main": "libs/backend/feature/order/shared/lib/src/index.ts",
        "tsConfig": "libs/backend/feature/order/shared/lib/tsconfig.lib.json",
        "assets": [],
        "rootDir": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/backend/feature/order/shared/lib",
        "command": "NODE_ENV=test vitest run --config vitest.config.mts"
      },
      "inputs": ["default", "^production", { "externalDependencies": ["vitest"] }],
      "outputs": ["{workspaceRoot}/coverage/libs/backend/feature/order/shared/lib"]
    }
  }
}
